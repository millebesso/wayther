# Copy to .env and adjust. docker compose reads .env automatically.
# .env is git-ignored — never commit real secrets.

# Postgres credentials (shared by the db and app services)
POSTGRES_USER=wayther
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wayther

# OpenRouteService API key (free tier). Get one at https://openrouteservice.org.
ORS_API_KEY=

# MET Norway requires an identifying User-Agent (with contact info) on every
# request — requests without it are rejected. Use a product token plus a real
# contact address you control.
METNO_USER_AGENT=wayther/0.1 (you@example.com)
